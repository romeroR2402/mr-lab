#!/usr/bin/env python3
"""adb FALSO solo para pruebas: reproduce salidas capturadas de adb real."""
import sys
a = sys.argv[1:]
if a[:1] == ["version"]:
    print("Android Debug Bridge version 1.0.41\nVersion 35.0.2-12147458"); sys.exit(0)
if a[:2] == ["devices", "-l"]:
    print("List of devices attached")
    print("R58N12ABCDE            device usb:1-1 product:a52qnsxx model:SM_A525F device:a52q transport_id:3")
    print("ZY22XXXXXX             unauthorized usb:1-2 transport_id:4")
    print("192.168.1.20:5555      device product:x model:Pixel_7 device:panther transport_id:5")
    if __import__("os").environ.get("FAKE_SIDELOAD") == "1":
        print("SIDE0001               sideload usb:1-5 transport_id:6")
    sys.exit(0)
if a[:1] == ["-s"] and a[2] == "reboot":
    log = __import__("os").environ.get("FAKE_ADB_LOG")
    if log:
        open(log, "a").write(" ".join(a) + "\n")
    sys.exit(0)
if a[:1] == ["-s"] and a[2] == "sideload":
    for pct in (10, 47, 100):
        sys.stdout.write(f"serving: '{a[3]}'  (~{pct}%)    \r"); sys.stdout.flush()
    print("\nTotal xfer: 1.00x"); sys.exit(0)
import os, shutil, subprocess
ROOT = os.environ.get("FAKE_SDCARD")
if a[:1] == ["-s"] and a[2] == "pull" and ROOT:
    src, dest = a[-2], a[-1]
    real = src.replace("/sdcard", ROOT, 1)
    if not os.path.exists(real):
        print(f"adb: error: failed to stat remote object '{src}': No such file or directory", file=sys.stderr); sys.exit(1)
    shutil.copytree(real, os.path.join(dest, os.path.basename(real)), dirs_exist_ok=True); sys.exit(0)
if a[:1] == ["-s"] and a[2] == "shell" and a[3].startswith("find ") and ROOT:
    out = subprocess.run(["sh", "-c", a[3].replace("/sdcard", ROOT)], capture_output=True, text=True).stdout
    print(out.replace(ROOT, "/sdcard"), end=""); sys.exit(0)
if a[:1] == ["-s"] and a[2] == "shell" and a[3].startswith("content query"):
    if os.environ.get("FAKE_CONTACTS") == "1":
        print("Row: 0 display_name=Ana López, mimetype=vnd.android.cursor.item/phone_v2, data1=+52 55 1234 5678")
        print("Row: 1 display_name=Ana López, mimetype=vnd.android.cursor.item/email_v2, data1=ana@example.com")
        print("Row: 2 display_name=Taller, mimetype=vnd.android.cursor.item/name, data1=Taller")
    else:
        print("Error while accessing provider:com.android.contacts\njava.lang.SecurityException: Permission Denial")
    sys.exit(0)
if a[:1] == ["-s"] and a[2] == "shell":
    cmd = a[3]
    if cmd == "getprop":
        for k, v in {"ro.product.manufacturer": "samsung", "ro.product.model": "SM-A525F", "ro.product.device": "a52q",
                     "ro.build.version.release": "14", "ro.build.version.sdk": "34", "ro.crypto.state": "encrypted",
                     "ro.crypto.type": "file", "ro.boot.verifiedbootstate": "green", "ro.boot.flash.locked": "1",
                     "ro.build.version.security_patch": "2024-03-01"}.items():
            print(f"[{k}]: [{v}]")
    elif cmd == "dumpsys battery":
        print("Current Battery Service state:\n  AC powered: false\n  USB powered: true\n  status: 2\n  health: 2\n  level: 54\n  scale: 100\n  voltage: 3912\n  temperature: 312\n  technology: Li-ion")
    elif cmd == "df -k /data":
        print("Filesystem      1K-blocks     Used Available Use% Mounted on\n/dev/block/dm-48 113524628 98000000 15524628  87% /data")
    elif cmd == "cat /proc/meminfo":
        print("MemTotal:        5668880 kB\nMemFree:          200000 kB\nMemAvailable:    2100000 kB")
    elif cmd == "wm size":
        print("Physical size: 1080x2400")
    elif cmd == "wm density":
        print("Physical density: 450")
    elif cmd == "dumpsys power":
        print("  mWakefulness=Awake\nDisplay Power: state=ON")
    elif cmd == "dumpsys input":
        print("Event Hub State:\n  Devices:\n    -1: Virtual\n      Classes: KEYBOARD | ALPHAKEY\n    3: sec_touchscreen\n      Classes: TOUCH | TOUCH_MT\n")
    elif cmd == "cat /proc/uptime":
        print("7384.12 20000.00")
    elif cmd == "locksettings get-disabled":
        print("false")
    elif cmd == "dumpsys device_policy":
        print("Device policy state:\n  Enabled Device Admins (User 0):\n")
    elif cmd == "pm list packages -3":
        print("package:com.example.juego\npackage:com.whatsapp")
    elif cmd.startswith("pm uninstall --user 0 "):
        print("Success")
    elif cmd.startswith("pm trim-caches"):
        pass
    elif cmd == "settings get global wifi_on":
        print("1")
    sys.exit(0)
sys.exit(1)
